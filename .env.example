# Database
POSTGRES_USER=docusage
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=docusage
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Hugging Face
HF_TOKEN=your_hf_token

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2

# Resend Email Delivery (Passwordless OTP)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Docusage Security <onboarding@resend.dev>"

# Security & App Environment
DOCUSAGE_ENV=development
SECRET_KEY=generate_a_secure_32_byte_random_string
JWT_SECRET=generate_a_secure_jwt_signing_secret
ENABLE_DEV_OTP=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000